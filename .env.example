RESEND_API_KEY=
CONTACT_EMAIL=support@fathomvision.app
FROM_EMAIL=Fathom <support@fathomvision.app>

# --- /promo rep tools -------------------------------------------------------
# Promo codes live in the Fathom Supabase project. The service-role key bypasses
# RLS, so it is server-only — never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://xjhphevzaqkvstvdlhzd.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Password for the /promo page. Server-side now: it is checked in a route
# handler, not in the browser, and unlocking issues a signed httpOnly cookie.
PROMO_PASSWORD=

# Optional. Signs the /promo session cookie; defaults to PROMO_PASSWORD.
# Set it to a long random string so changing the password doesn't have to
# invalidate every open session (and vice versa).
PROMO_SESSION_SECRET=
